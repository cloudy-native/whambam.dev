---
import { siteConfig } from "../config/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6"
  >
    <div class="flex items-center gap-6">
      <a href="/" class="font-bold tracking-tight text-foreground">
        {siteConfig.name}
      </a>
      <div class="hidden items-center gap-4 lg:flex">
        {
          siteConfig.navItems.map((item) => {
            const active =
              item.href === "/"
                ? pathname === "/"
                : pathname.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  "text-sm transition-colors",
                  active
                    ? "font-medium text-foreground"
                    : "text-muted hover:text-foreground",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={siteConfig.links.github}
        title="GitHub"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-foreground"
      >
        <svg
          height="22"
          width="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"
          ></path>
        </svg>
      </a>
      <a
        href={siteConfig.links.linkedin}
        title="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-muted hover:text-foreground sm:inline-flex"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="currentColor"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <path
            d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
          ></path>
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-lg p-1 text-muted transition-opacity hover:opacity-80"
        aria-label="Toggle dark mode"
      >
        <svg
          id="icon-sun"
          class="hidden h-[22px] w-[22px] dark:block"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M19 12a7 7 0 11-7-7 7 7 0 017 7z"
          ></path>
          <path
            d="M12 22.96a.969.969 0 01-1-.96v-.08a1 1 0 012 0 1.038 1.038 0 01-1 1.04zm7.14-2.82a1.024 1.024 0 01-.71-.29l-.13-.13a1 1 0 011.41-1.41l.13.13a1 1 0 010 1.41.984.984 0 01-.7.29zm-14.28 0a1.024 1.024 0 01-.71-.29 1 1 0 010-1.41l.13-.13a1 1 0 011.41 1.41l-.13.13a1 1 0 01-.7.29zM22 13h-.08a1 1 0 010-2 1.038 1.038 0 011.04 1 .969.969 0 01-.96 1zM2.08 13H2a1 1 0 010-2 1.038 1.038 0 011.04 1 .969.969 0 01-.96 1zm16.93-7.01a1.024 1.024 0 01-.71-.29 1 1 0 010-1.41l.13-.13a1 1 0 011.41 1.41l-.13.13a.984.984 0 01-.7.29zm-14.02 0a1.024 1.024 0 01-.71-.29l-.13-.14a1 1 0 011.41-1.41l.13.13a1 1 0 010 1.41.97.97 0 01-.7.3zM12 3.04a.969.969 0 01-1-.96V2a1 1 0 012 0 1.038 1.038 0 01-1 1.04z"
          ></path>
        </svg>
        <svg
          id="icon-moon"
          class="block h-[22px] w-[22px] dark:hidden"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M21.53 15.93c-.16-.27-.61-.69-1.73-.49a8.46 8.46 0 01-1.88.13 8.409 8.409 0 01-5.91-2.82 8.068 8.068 0 01-1.44-8.66c.44-1.01.13-1.54-.09-1.76s-.77-.55-1.83-.11a10.318 10.318 0 00-6.32 10.21 10.475 10.475 0 007.04 8.99 10 10 0 002.89.55c.16.01.32.02.48.02a10.5 10.5 0 008.47-4.27c.67-.93.49-1.519.32-1.79z"
          ></path>
        </svg>
      </button>

      <!-- Mobile menu -->
      <details class="relative lg:hidden">
        <summary
          class="cursor-pointer list-none rounded-md px-2 py-1 text-sm text-muted hover:text-foreground"
        >
          Menu
        </summary>
        <div
          class="absolute right-0 mt-2 w-44 rounded-lg border border-border bg-card p-2 shadow-lg"
        >
          {
            siteConfig.navItems.map((item) => (
              <a
                href={item.href}
                class="block rounded-md px-3 py-2 text-sm text-foreground hover:bg-background"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.classList.contains("dark") ? "light" : "dark";
    root.classList.toggle("dark", next === "dark");
    try {
      localStorage.setItem("theme", next);
    } catch (_) {
      /* ignore */
    }
  });
</script>
