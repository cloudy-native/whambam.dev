---
import Layout from "../layouts/Layout.astro";
import { Content } from "../content/docs.md";
import { siteConfig } from "../config/site";
---

<Layout
  title={`Documentation · ${siteConfig.name}`}
  description="Install, usage, and UI guide for whambam."
>
  <article class="w-full p-2 pb-12 md:p-8">
    <header class="mb-8 scroll-mt-24">
      <h1
        class="tracking-tight font-semibold text-4xl lg:text-6xl bg-clip-text text-transparent bg-gradient-to-b from-foreground to-muted"
      >
        Documentation
      </h1>
    </header>
    <section
      class="prose prose-zinc dark:prose-invert max-w-none
      prose-headings:scroll-mt-24 prose-h1:mt-0 prose-h2:mt-10 prose-h3:mt-8
      prose-a:text-blue-600 dark:prose-a:text-blue-400 hover:prose-a:underline
      prose-pre:bg-zinc-50 dark:prose-pre:bg-zinc-950 prose-pre:text-zinc-900 dark:prose-pre:text-zinc-100
      prose-pre:border prose-pre:border-zinc-200 dark:prose-pre:border-zinc-800 prose-pre:rounded-lg
      prose-code:before:content-[''] prose-code:after:content-['']
      prose-img:rounded-lg prose-hr:my-10"
    >
      <Content />
    </section>
  </article>
</Layout>
