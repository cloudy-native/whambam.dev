---
import Layout from "../layouts/Layout.astro";
import InstallTabs from "../components/InstallTabs.astro";
import { siteConfig } from "../config/site";

const features = [
  [
    "Steer the load live",
    "Press + and - for workers, ] and [ for request rate. Each change is marked on the charts, so you can find the point where latency turns.",
  ],
  [
    "Watch it happen",
    "Throughput and latency on one timeline, percentiles, status codes and errors, updated ten times a second.",
  ],
  [
    "Compare as you go",
    "Load a saved baseline and every number shows its change, red when worse, with reference lines on the charts.",
  ],
  [
    "Then automate it",
    "Fail CI with --assert 'p99<200ms,errors<1%', in any pipeline or with the bundled GitHub Action. hey's flags work too.",
  ],
];
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <section class="flex flex-col items-center justify-center gap-4 py-8 md:py-10">
    <div class="inline-block max-w-2xl text-center justify-center">
      <h1 class="tracking-tight inline font-semibold text-[2.3rem] lg:text-5xl leading-9">
        Run&nbsp;<span
          class="bg-clip-text text-transparent bg-gradient-to-b from-[#FF1CF7] to-[#b249f8]"
          >whambam&nbsp;</span
        >
        <br />
        to test your website performance.
      </h1>
      <p class="mt-4 w-full text-lg lg:text-xl text-muted">
        HTTP load testing you can steer. Watch throughput and latency live, and turn the load
        up or down from the keyboard while the test runs.
      </p>
      <p class="mt-2 w-full text-base text-muted">
        A maintained, hey-compatible alternative for macOS, Linux and Windows, on x86_64 and
        ARM64.
      </p>
    </div>

    <div class="mt-6 w-full max-w-2xl">
      <InstallTabs />
      <div
        class="mt-3 rounded-xl border border-border bg-card px-4 py-3 font-mono text-sm text-left shadow-sm"
      >
        <span class="select-none text-muted">$ </span>whambam -z 10s https://example.com
      </div>
    </div>

    <div class="mt-8 w-full max-w-4xl">
      <div class="aspect-video w-full overflow-hidden rounded-lg border border-border shadow-md">
        <iframe
          class="h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${siteConfig.video.id}?rel=0`}
          title={siteConfig.video.title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <p class="mt-2 text-center text-sm text-muted">
        The 8-minute explainer: live controls, honest p99s and benchmarks ·
        <a href={`https://youtu.be/${siteConfig.video.id}`} class="underline hover:text-foreground">watch on YouTube</a>
      </p>
    </div>

    <div class="mt-8 grid w-full max-w-4xl gap-4 sm:grid-cols-2">
      {
        features.map(([title, text]) => (
          <div class="rounded-xl border border-border bg-card p-4">
            <h2 class="font-semibold">{title}</h2>
            <p class="mt-1 text-sm text-muted">{text}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-sm text-muted">
      <a href="/docs" class="underline hover:text-foreground">Read the docs</a>{" · "}<a href={siteConfig.links.github} class="underline hover:text-foreground">GitHub</a>
    </p>
  </section>
</Layout>
