{
  "name": "whambam-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cdk:build": "pnpm --filter cdk run build",
    "cdk:test": "pnpm --filter cdk run test",
    "cdk:synth": "pnpm --filter cdk exec cdk synth",
    "cdk:diff": "pnpm --filter cdk exec cdk diff",
    "cdk:deploy": "pnpm --filter cdk exec cdk deploy"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^5.12.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.3"
  }
}
